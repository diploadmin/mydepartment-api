"""
Aggregate unique city / country / organisation values from Weaviate documents.

Scans only ``DiploDocument_contextual``; values are propagated to
chunks/paragraphs at ingest time (same approach as person catalog).
"""

from __future__ import annotations

import threading
import time
from datetime import datetime, timezone
from typing import Any, Dict, Optional, Set

import weaviate

from app.core.collections import DOCUMENT
from app.core.config import PERSON_LIST_CACHE_TTL_SECONDS
from app.core.logging import logger
from app.core.singleton import Singleton

_SCAN_COLLECTION = DOCUMENT
_BATCH_SIZE = 500
_CATALOG_FIELDS = ("city", "country", "organisation")

_cache_lock = threading.Lock()
_cache_payload: Optional[Dict[str, Any]] = None
_cache_expires_at: float = 0.0


def _collect_text_value(value: Any, values: Set[str]) -> None:
    if value is None:
        return
    if isinstance(value, str):
        stripped = value.strip()
        if stripped:
            values.add(stripped)


def _is_public_visibility(props: Dict[str, Any]) -> bool:
    visibility = props.get("visibility")
    if visibility is None:
        return True
    if isinstance(visibility, str):
        return visibility.strip().lower() != "private"
    return True


def _scan_collection(
    client: weaviate.WeaviateClient,
    collection_name: str,
    field_values: Dict[str, Set[str]],
) -> int:
    collection = client.collections.get(collection_name)
    scanned = 0
    included = 0

    for obj in collection.iterator(
        return_properties=list(_CATALOG_FIELDS) + ["visibility"],
        cache_size=_BATCH_SIZE,
    ):
        scanned += 1
        props = obj.properties or {}
        if not _is_public_visibility(props):
            continue
        included += 1
        for field in _CATALOG_FIELDS:
            _collect_text_value(props.get(field), field_values[field])

    logger.info(
        f"[metadata] {collection_name}: scanned {scanned:,} objects, "
        f"{included:,} non-private"
    )
    return scanned


def _build_catalog() -> Dict[str, Any]:
    client = Singleton().weaviate_client
    field_values: Dict[str, Set[str]] = {field: set() for field in _CATALOG_FIELDS}
    sources: Dict[str, int] = {}

    logger.info(f"[metadata] Scanning {_SCAN_COLLECTION} for city/country/organisation...")
    sources[_SCAN_COLLECTION] = _scan_collection(client, _SCAN_COLLECTION, field_values)

    return {
        "cities": sorted(field_values["city"]),
        "countries": sorted(field_values["country"]),
        "organisations": sorted(field_values["organisation"]),
        "counts": {field: len(field_values[field]) for field in _CATALOG_FIELDS},
        "sources": sources,
        "cached": False,
        "generated_at": datetime.now(timezone.utc),
    }


def list_metadata_filters(*, refresh: bool = False) -> Dict[str, Any]:
    """Return unique city/country/organisation values from Weaviate."""
    global _cache_payload, _cache_expires_at

    now = time.monotonic()
    if not refresh:
        with _cache_lock:
            if _cache_payload is not None and now < _cache_expires_at:
                return {**_cache_payload, "cached": True}

    try:
        payload = _build_catalog()
    except Exception as exc:
        logger.exception("[metadata] Weaviate scan failed")
        raise RuntimeError(f"Weaviate metadata catalog scan failed: {exc}") from exc

    with _cache_lock:
        _cache_payload = payload
        _cache_expires_at = time.monotonic() + PERSON_LIST_CACHE_TTL_SECONDS

    return payload
